# Lilycosrent Review — Environment Variables
# Copy this file to `.env` and fill in your Firebase project credentials.
# NEVER commit `.env` to version control.

# Firebase Configuration
# Astro exposes PUBLIC_* variables to the client (see src/lib/firebase.ts)
PUBLIC_FIREBASE_API_KEY=your_api_key_here
PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=your_project_id
PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
PUBLIC_FIREBASE_APP_ID=your_app_id

# Admin Dashboard
# Kode akses untuk halaman admin statistik ulasan
PUBLIC_ADMIN_KEY=.gaktau123

</parameter>