---
import { ClientRouter } from 'astro:transitions';
import ReviewForm from '../components/ReviewForm.svelte';
import ReviewGallery from '../components/ReviewGallery.svelte';
import MusicPlayer from '../components/MusicPlayer.svelte';
import MotionEffects from '../components/MotionEffects.svelte';
import { Toaster } from 'svelte-sonner';
import '../styles/global.css';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Review pengalaman rental kostum kamu di Lilycosrent dan bantu bestie cosplay lainnya." />
    <meta name="theme-color" content="#fff0f6" />
    <title>lilycosrent_ — review corner ♡</title>
    <ClientRouter />
    <link rel="preload" href="/fonts/wXKrE3kTposypRyd51jcAA.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/XRXV3I6Li01BKofINeaB.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <Toaster position="top-center" richColors closeButton />

    <div class="review-page">
      <header class="cute-nav" data-reveal="fade">
        <a class="cute-brand" href="/" aria-label="lilycosrent review corner beranda">
          <span class="brand-avatar" aria-hidden="true"><img src="/lilycosrent-avatar-square.webp" alt="" width="512" height="512" loading="eager" decoding="async" /></span>
          <span class="brand-word"><strong>lilycosrent_</strong><small>review corner</small></span>
        </a>
        <div class="nav-links">
          <details class="nav-menu">
            <summary>Menu <span class="nav-chevron" aria-hidden="true"></span></summary>
            <div class="nav-menu-panel">
              <a href="/" data-astro-prefetch="viewport"><span aria-hidden="true">✦</span> Halaman review</a>
              <a href="/qr" data-astro-prefetch="viewport"><span aria-hidden="true">▣</span> QR &amp; kartu</a>
              <a href="/admin" data-astro-prefetch="viewport"><span aria-hidden="true">♡</span> Dashboard admin</a>
            </div>
          </details>
        </div>
      </header>

      <main class="page-content">
        <section class="form-first-layout" id="tulis-ulasan" aria-labelledby="form-title">
          <section class="form-shell" aria-label="Form ulasan rental kostum" data-reveal="up">
            <div class="form-shell-header">
              <div>
                <p class="mini-label"><span aria-hidden="true">✦</span> LILY'S REVIEW CORNER</p>
                <h1 id="form-title">Gimana kostumnya, bestie?</h1>
                <p class="form-intro">Makasih sudah rental di Lilycosrent. Isi sebentar yaa, cerita kamu berarti banget ♡</p>
              </div>
              <span class="mini-sticker" aria-hidden="true">✎</span>
            </div>
            <ReviewForm client:load />
          </section>

          <aside class="chibi-greeting" aria-label="Sambutan dari maskot Cosplay Review" data-reveal="up" data-delay="2">
            <div class="chibi-sparkle sparkle-one" aria-hidden="true">✦</div>
            <div class="chibi-sparkle sparkle-two" aria-hidden="true">♡</div>
            <div class="greeting-copy">
              <p class="greeting-chip">haii, bestie Lilycosrent! <span aria-hidden="true">♡</span></p>
              <h2>cerita kamu<br /><em>berarti</em> banget.</h2>
              <p>Review jujur dari kamu bantu bestie cosplay lainnya rental dengan lebih tenang.</p>
              <div class="cute-tags" aria-label="Area layanan Lilycosrent">
                <span>Serang</span><span>Tangerang</span><span>Jabodetabek</span>
              </div>
            </div>
            <figure class="chibi-art">
              <div class="speech-bubble">makasih sudah rental~ <span aria-hidden="true">♡</span></div>
              <img src="/chibi-review-card.webp" alt="Maskot chibi Lilycosrent sedang menyapa sambil membawa kostum pink" width="1200" height="1600" loading="eager" decoding="async" />
            </figure>
          </aside>
        </section>

        <p class="review-scroll-hint" data-reveal="fade"><span class="scroll-badge" aria-hidden="true">↓</span> Sudah isi? Sekalian intip cerita customer lain di bawah, yuk.</p>

        <section class="wall-section" id="ulasan" aria-labelledby="wall-title" data-reveal="up">
          <div class="wall-header">
            <div>
              <p class="section-kicker"><span aria-hidden="true">♡</span> CERITA DARI BESTIE RENTAL</p>
              <h2 id="wall-title">Lily's Wall of <em>Love</em></h2>
              <p>Pengalaman real dari bestie yang sudah rental di Lilycosrent.</p>
            </div>

          </div>
          <ReviewGallery client:visible />
        </section>
      </main>

      <footer class="site-footer" data-reveal="fade">
        <span aria-hidden="true">♡</span>
        <p>made with love by lilycosrent_</p>
        <span aria-hidden="true">♡</span>
      </footer>

      <MotionEffects client:load transition:persist="motion-runtime" />
      <MusicPlayer client:load transition:persist="site-audio" />
    </div>
  </body>
</html>
